{
  "version": "1.0",
  "monorepo_type": "polyglot",
  "packages": [
    {
      "name": "monoflow",
      "path": ".",
      "language": "go",
      "version": "1.0.0",
      "dependencies": [],
      "test_cmd": "go test -race ./pkg/... ./cmd/...",
      "typecheck_cmd": "go vet ./pkg/... ./cmd/...",
      "lint_cmd": "go vet ./pkg/..."
    },
    {
      "name": "docs",
      "path": "docs",
      "language": "javascript",
      "version": "1.0.0",
      "dependencies": [
        "monoflow"
      ],
      "test_cmd": "node test.js",
      "typecheck_cmd": "node -c app.js",
      "lint_cmd": "node test.js"
    }
  ]
}